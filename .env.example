# ---------- App ----------
# Public URL of the site, with trailing slash
APP_URL=http://127.0.0.1/hms/
# Where images/ and uploads/ are served from. On Vercel: your Blob store public URL,
# e.g. https://xxxxxxxx.public.blob.vercel-storage.com/  (leave empty locally)
ASSET_BASE_URL=
# Vercel Blob read/write token (leave empty locally -> files are saved to disk)
BLOB_READ_WRITE_TOKEN=

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=hms
# Set to 1 for hosted MySQL that requires TLS (Aiven, TiDB, PlanetScale...)
DB_SSL=0
# Optional path to a CA certificate file
DB_SSL_CA=

# ---------- PayHere ----------
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CURRENCY=LKR
PAYHERE_EMAIL=
# 1 = sandbox.payhere.lk, 0 = live
PAYHERE_SANDBOX=1

# ---------- SMTP (PHPMailer) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=HMS Team
